<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Required by LocationManager.sendExtraCommand, used to refresh the GNSS
         assistance data so a cold fix does not take a minute. Normal-level
         permission: no runtime prompt, and it grants no access to location
         itself. -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- MapLibre's ConnectivityReceiver asks ConnectivityManager when the system reports a change.
         Normal-level permission: no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Offline voice search. Asked at runtime, the first time the search microphone is tapped with
         the offline speech model installed; used only while the listening screen is open. The
         system recogniser path needs no permission of Roadstr. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- MeshCore radio (optional feature, off until the user pairs a radio). Android 12+ asks for
         scan and connect at runtime; scan declares it never derives location from it. Before
         Android 12 the legacy pair is install-time only and a scan needs the location permission
         that is already declared above. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <queries>
        <!-- The MeshCore settings open MeshCore Open, where the user allows Roadstr. -->
        <package android:name="com.meshcore.meshcore_open" />
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nostrsigner" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="lightning" />
        </intent>
    </queries>

    <application
        android:label="Roadstr"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:enabled="${flutterLauncherEnabled}"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <meta-data
                android:name="flutterEmbedding"
                android:value="2"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- No custom-scheme (roadstr://) intent-filter: Amber (NIP-55)
                 returns results via startActivityForResult/onActivityResult,
                 not a deep-link callback, so an exported BROWSABLE filter would
                 be unused attack surface any website could trigger. -->
        </activity>
        <!-- The Kotlin app. Only one of the two launchers is enabled in a given build (see
             `native_launcher` in app/build.gradle.kts); this one imports the Flutter app's data
             before it shows the map. -->
        <activity
            android:name=".startup.NativeAppActivity"
            android:enabled="${nativeLauncherEnabled}"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/NativeCanaryTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Tankful sends its bounded destination JSON to this launcher explicitly. Keep
                 ACTION_SEND out of an intent-filter: Roadstr must not become a global share target. -->
        </activity>
        <!-- Dormant Compose packaging canary. It has no external intent filter
             and no production code launches it; MainActivity remains the sole
             MAIN/LAUNCHER entry point until the native cutover is approved. -->
        <activity
            android:name=".feature.home.NativeCanaryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/NativeCanaryTheme" />
        <service
            android:name=".service.navigation.NativeNavigationForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
