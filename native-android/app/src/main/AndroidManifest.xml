<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <!-- MapLibre's ConnectivityReceiver queries ConnectivityManager when the
         system sends CONNECTIVITY_CHANGE. This is a normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nostrsigner" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="lightning" />
        </intent>
    </queries>
    <uses-permission
        android:name="android.permission.ACCESS_WIFI_STATE"
        tools:node="remove" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/native_road_test_app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/NativeCanaryTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".roadtest.NativeRoadTestActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/NativeCanaryTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The road-test accepts the same explicit JSON Intent as production, without
                 advertising an implicit ACTION_SEND share target. -->
        </activity>
        <!-- Only the optional GeckoView build has this component. It is exported so other apps can
             read what the browser copied; Roadstr does not offer that, so it is removed. -->
        <provider
            android:name="org.mozilla.gecko.GeckoClipboardContentProvider"
            tools:node="remove" />
    </application>

</manifest>
