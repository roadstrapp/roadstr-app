#!/bin/sh
# Builds the optional in-app browser variant (GeckoView) of the road-test app, for example:
#   ./gradlew-geckoview :app:assembleDebug
# The default build is ./gradlew and does not change. See docs/world-discovery/PLAN.md, D-11.
set -eu
APP_HOME=$(cd "$(dirname "$0")" && pwd -P)
JAVA=java
if [ -n "${JAVA_HOME:-}" ]; then JAVA="$JAVA_HOME/bin/java"; fi
exec "$JAVA" -Dorg.gradle.appname=gradlew-geckoview \
    -classpath "$APP_HOME/gradle/wrapper-geckoview/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain -Pgeckoview=true "$@"
